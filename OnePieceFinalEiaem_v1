local JuiceTab = Window:CreateTab("Auto Juice", 4483345998)
JuiceTab:CreateSection("Juicing Bowl")

local autoJuiceRunning = false
local juiceDelay = 0.3

local function getKitchenStation()
    local path = workspace:FindFirstChild("MapFolder")
        and workspace.MapFolder:FindFirstChild("Island8")
        and workspace.MapFolder.Island8:FindFirstChild("Kitchen")
    if not path then return nil end
    return path:GetChildren()[2]
end

local function getJuiceParts()
    local station = getKitchenStation()
    if not station then return nil end
    local bowl = station:FindFirstChild("JuicingBowl")
    if not bowl then return nil end
    return {
        mixer    = bowl:FindFirstChild("JuicingBowlMixer"),
        bowlPart = bowl:FindFirstChild("Bowl"),
        mixer1   = bowl:FindFirstChild("Mixer1"),
        mixer2   = bowl:FindFirstChild("Mixer2"),
        bowlModel = bowl,
    }
end

local function teleportToPart(part)
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp or not part then return end
    local root
    if part:IsA("BasePart") then
        root = part
    elseif part:IsA("Model") then
        root = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
    else
        root = part:FindFirstChildWhichIsA("BasePart")
    end
    if root then hrp.CFrame = root.CFrame * CFrame.new(0, 0, 2) end
end

local function firePromptOnPart(part)
    if not part then return end
    local prompt = part:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then
        for _, child in ipairs(part:GetDescendants()) do
            if child:IsA("ProximityPrompt") then prompt = child break end
        end
    end
    if prompt then pcall(fireproximityprompt, prompt) end
end

local function doJuiceCycle()
    local parts = getJuiceParts()
    if not parts then
        Rayfield:Notify({ Title="Juice", Content="ไม่พบ JuicingBowl!", Duration=3 })
        return false
    end
    teleportToPart(parts.bowlPart)
    task.wait(juiceDelay)
    firePromptOnPart(parts.bowlPart)
    task.wait(juiceDelay)
    teleportToPart(parts.mixer1)
    task.wait(juiceDelay)
    firePromptOnPart(parts.mixer1)
    task.wait(juiceDelay)
    teleportToPart(parts.mixer2)
    task.wait(juiceDelay)
    firePromptOnPart(parts.mixer2)
    task.wait(juiceDelay)
    teleportToPart(parts.mixer)
    task.wait(juiceDelay)
    firePromptOnPart(parts.mixer)
    task.wait(juiceDelay)
    return true
end

local function autoJuiceLoop()
    while autoJuiceRunning do
        local ok2, err = pcall(doJuiceCycle)
        if not ok2 then
            warn("Juice error:", err)
            Rayfield:Notify({ Title="Juice Error", Content=tostring(err), Duration=3 })
        end
        task.wait(1)
    end
end

