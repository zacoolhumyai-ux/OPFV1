-- One Piece Final Nerd V1 | Full Script | Rayfield UI
local ok, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)
if not ok or not Rayfield then
    warn("Rayfield failed to load: " .. tostring(Rayfield))
    return
end

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local ModuleScript = game:GetService("ReplicatedFirst"):FindFirstChildOfClass("ModuleScript")
local v1
if ModuleScript then
    local reqOk, result = pcall(require, ModuleScript)
    if reqOk then v1 = result end
end

local function fire(p1, p2)
    if not v1 then return end
    local s, e = pcall(function() return v1["\t"](p1, p2) end)
    if not s then warn("fire error:", e) end
end

local function getData()
    if not _G.Data or not player then return nil end
    return _G.Data[player.UserId]
end

