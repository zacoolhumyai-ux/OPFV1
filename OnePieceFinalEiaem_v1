local function buyDrink(drinkName, amount)
    local merchant = getMerchant()
    if not merchant then
        -- teleport ไปหา NPC ก่อนแล้ว retry
        local npc = workspace:FindFirstChild("Ignore")
            and workspace.Ignore:FindFirstChild("NPCs")
            and workspace.Ignore.NPCs:FindFirstChild("Shop")
