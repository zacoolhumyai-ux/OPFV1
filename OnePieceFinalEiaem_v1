-- หา mob ที่มีชีวิตอยู่ตาม list ที่เลือก
local function findAliveMonsters(nameList)
    local alive = workspace:FindFirstChild("Alive")
    if not alive then return {} end
    local nameSet = {}
    for _, n in ipairs(nameList) do nameSet[n] = true end
    local found = {}
    for _, model in ipairs(alive:GetChildren()) do
        if nameSet[model.Name] then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                table.insert(found, { model=model, hum=hum, hrp=hrp })
            end
        end
    end
    return found
end

-- Teleport char ไปหน้า mob (ไม่แตะ mob เลย)
local function teleportToMob(monHRP)
    local char = player.Character
    if not char then return false end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end
    myHRP.CFrame = monHRP.CFrame * CFrame.new(0, 0, bringDistance)
    return true
end

-- โจมตี mob (ไม่ขยับ mob)
local function attackMob(entry)
    local model = entry.model
    local hum   = entry.hum
    if not (model and hum) or hum.Health <= 0 then return end
    if v1 then
        pcall(function() v1["\t"]("MobHit",    { model, farmDamage }) end)
        pcall(function() v1["\t"]("DamageNPC", { model, farmDamage }) end)
    end
    pcall(function() hum:TakeDamage(farmDamage) end)
    local char = player.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end
end

local function autoFarmLoop()
    while autoFarmRunning do
        if #selectedMonsters == 0 then
            Rayfield:Notify({ Title="Farm", Content="ยังไม่ได้เลือก Monster!", Duration=2 })
            task.wait(3)
            continue
        end

        local targets = findAliveMonsters(selectedMonsters)
        if #targets == 0 then
            task.wait(1)
            continue
        end

        for _, entry in ipairs(targets) do
            if not autoFarmRunning then break end

            -- ตรวจสอบ mob ยังมีชีวิตอยู่มั้ย
            local hum = entry.hum
            local hrp = entry.hrp
            if not hum or not hrp or hum.Health <= 0 then
                -- mob ตายแล้ว → ข้ามไปตัวถัดไปทันที
                continue
            end

            -- Teleport char ไปหน้า mob
            local ok2 = pcall(teleportToMob, hrp)
            if not ok2 then continue end
            task.wait(0.05)

            -- วน ตี mob จนกว่า mob จะตาย หรือ farm ถูกปิด
            while autoFarmRunning do
                -- เช็ค mob ยังอยู่มั้ย (อาจถูก despawn / ตายระหว่างตี)
                if not hum or not hum.Parent or hum.Health <= 0 then
                    -- mob ตายแล้ว → ออกจาก loop ตี → วาร์ปไปตัวถัดไป
                    break
                end

                -- ตี
                pcall(attackMob, entry)
                task.wait(farmDelay)

                -- เช็ค HP หลังตี
                if hum.Health <= 0 then break end
            end
        end
    end
end

