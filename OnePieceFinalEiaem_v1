local function getMonsterHRP(monster)
    if not monster then return nil end
    local hrp = monster:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp end
    return monster.PrimaryPart or monster:FindFirstChildWhichIsA("BasePart")
end

local function getMonsterHumanoid(monster)
    if not monster then return nil end
    return monster:FindFirstChildOfClass("Humanoid")
        or monster:FindFirstChildWhichIsA("Humanoid")
end

local function teleportToMonster(monster)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local monHRP = getMonsterHRP(monster)
    if not monHRP then return end
    hrp.CFrame = monHRP.CFrame * CFrame.new(0, 0, teleportDistance)
end

local function autoFarmLoop()
    while autoFarmRunning do
        if #selectedMonsters == 0 then
            Rayfield:Notify({
                Title = "Farm",
                Content = "ยังไม่ได้เลือก Monster!",
                Duration = 2
            })
            task.wait(3)
        else
            for _, name in ipairs(selectedMonsters) do
                if not autoFarmRunning then break end

                local alive = workspace:FindFirstChild("Alive")
                local monster = alive and alive:FindFirstChild(name)

                if monster then
                    local hum = getMonsterHumanoid(monster)
                    if hum and hum.Health > 0 then
                        pcall(teleportToMonster, monster)
                        task.wait(farmDelay)
                    else
                        -- monster ตายแล้ว ข้ามไปตัวถัดไป
                        task.wait(0.5)
                    end
                else
                    task.wait(0.5)
                end
            end
        end
    end
end

