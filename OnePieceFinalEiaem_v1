local FlintlockTab = Window:CreateTab("Flintlock", 4483345998)
FlintlockTab:CreateSection("Fast Attack")

local autoFlintlockRunning = false
local flintlockDelay = 0.35
local flintlockDamage = 25

local function getFlintlock()
    local char = player.Character
    if not char then return nil end
    local alive = char:FindFirstChild("Alive")
    if not alive then return nil end
    local thNerdZ = alive:FindFirstChild("ThNerdZ")
    if not thNerdZ then return nil end
    return thNerdZ:FindFirstChild("Flintlock")
end

local function doFlintlockAttack()
    local flintlock = getFlintlock()
    if not flintlock then return false end

    local weld         = flintlock:FindFirstChild("WeldConstraint")
    local firePosition = flintlock:FindFirstChild("FirePosition")
    local handle       = flintlock:FindFirstChild("Handle")

    if not (weld and firePosition and handle) then return false end

    -- Raycast จาก FirePosition ตาม LookVector ของ Handle
    local origin    = firePosition.WorldPosition
    local direction = handle.CFrame.LookVector * 120

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = { player.Character }
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local result = workspace:Raycast(origin, direction, rayParams)

    if result then
        local hitChar = result.Instance:FindAncestorOfClass("Model")
        if hitChar then
            local hum = hitChar:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and hitChar ~= player.Character then
                hum:TakeDamage(flintlockDamage)
            end
        end
    end

    -- Recoil: ปิด WeldConstraint ชั่วคราว
    weld.Enabled = false
    task.delay(0.05, function()
        if weld and weld.Parent then
            weld.Enabled = true
        end
    end)

    return true
end

local function autoFlintlockLoop()
    while autoFlintlockRunning do
        local ok2, err = pcall(doFlintlockAttack)
        if not ok2 then
            warn("Flintlock error:", err)
        end
        task.wait(flintlockDelay)
    end
end

